<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Edit in GIMP</name>
    <id>org.sandbranch.filter.edit-in-gimp</id>
    <param name="tab" type="notebook">
        <page name="options" gui-text="Options">
            <param name="gimp" type="string" gui-text="GIMP program:" gui-description="Empty: gimp. Or a command such as flatpak run org.gimp.GIMP">gimp</param>
        </page>
        <page name="help" gui-text="Help">
            <label xml:space="preserve">Opens the selected image in GIMP. An embedded image is first saved next to the drawing (in a folder named after it) and linked.

In GIMP, paint and add layers as you like, then File > Inkscape Link > Send to Inkscape: GIMP writes the image back and keeps your layers in a .xcf file next to it, which opens again next time. Inkscape shows the change by itself (Preferences > Imported Images > Automatically reload images).

Needs the GIMP plug-in from the same package.</label>
        </page>
    </param>
    <effect needs-live-preview="false">
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Images"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">edit_in_gimp.py</command>
    </script>
</inkscape-extension>
